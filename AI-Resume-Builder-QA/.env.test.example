# 使用 scripts/create_local_env.py 生成本地 .env.test；不要填写或提交真实账号和密钥。
COMPOSE_PROJECT_NAME=arb-qa
QA_RUN_ID=replace_with_short_run_id
QA_BASE_URL=http://127.0.0.1:18999
QA_UI_BASE_URL=http://127.0.0.1:15173
QA_RUN_LIVE_CONTRACT=1
QA_RUN_RAG_INTEGRATION=1
QA_ALLOW_RAG_WRITES=1
QA_RUN_UI=0
QA_ADMIN_USERNAME=replace_with_qa_admin_username
QA_ADMIN_PASSWORD=replace_with_local_random_password
QA_USER_USERNAME=replace_with_qa_user_username
QA_USER_PASSWORD=replace_with_local_random_password
QA_BACKEND_PORT=18999
QA_FRONTEND_PORT=15173
QA_MOCK_AI_PORT=18080
QA_MYSQL_PORT=13306
QA_PGVECTOR_PORT=15433
QA_MINIO_API_PORT=19000
QA_MINIO_CONSOLE_PORT=19001
QA_MYSQL_DATABASE=resume_builder_qa
QA_MYSQL_ROOT_PASSWORD=replace_with_local_random_password
QA_POSTGRES_DB=resume_builder_qa
QA_POSTGRES_USER=qa_pgvector
QA_POSTGRES_PASSWORD=replace_with_local_random_password
QA_MINIO_ROOT_USER=qa_minio_root
QA_MINIO_ROOT_PASSWORD=replace_with_local_random_password
QA_MINIO_APP_ACCESS_KEY=qa_rag_app
QA_MINIO_APP_SECRET_KEY=replace_with_local_random_password
QA_AUTH_TOKEN_SECRET=replace_with_local_random_secret
QA_SYSTEM_CONFIG_ENCRYPTION_KEY=replace_with_base64_32_byte_key
QA_MOCK_API_KEY=replace_with_local_placeholder_key
APP_INTERVIEW_CONTEXT_SOFT_CHARS=24000
APP_INTERVIEW_CONTEXT_HARD_CHARS=32000
APP_INTERVIEW_SUMMARY_CHARS=3000
MOCK_AI_DEFAULT_SCENARIO=normal
MOCK_AI_TIMEOUT_DELAY_SECONDS=0.2
MOCK_EMBEDDING_DIMENSIONS=1024
MOCK_VISION_DELAY_SECONDS=0
MOCK_EMBEDDING_DELAY_SECONDS=0
MOCK_INTERVIEW_FIRST_CHUNK_DELAY_SECONDS=0.5
MOCK_INTERVIEW_CHUNK_COUNT=20
MOCK_INTERVIEW_CHUNK_INTERVAL_SECONDS=0.05
MOCK_INTERVIEW_STREAM_BEHAVIOR=normal
QA_IMAGE_POLL_TIMEOUT_SECONDS=180
QA_IMAGE_POLL_INTERVAL_SECONDS=1
PERF_ALLOW_RAG_WRITES=0
PERF_RUN_IMAGE_WORKER=0
PERF_IMAGE_PORT_BASE=19680
PERF_IMAGE_WARMUP_SAMPLES=2
PERF_IMAGE_MEASURE_SAMPLES=20
PERF_MODEL_MODE=mock
# 真实性能模式只在当前进程设置 PERF_REAL_CHAT_*、PERF_REAL_EMBEDDING_*、PERF_REAL_VISION_*，不要写入本文件。
PERF_TASK_WAIT_MIN_SECONDS=1
PERF_TASK_WAIT_MAX_SECONDS=2
QA_RAG_IMAGE_ENRICHMENT_CONCURRENCY=3
QA_RUN_RAG_QUALITY=0
QA_ALLOW_QUALITY_WRITES=0
QA_QUALITY_REAL_MODELS_CONFIRMED=0
QA_ALLOW_REMOTE_QUALITY=0
QA_QUALITY_REPEAT_COUNT=2
QA_RUN_DEEPEVAL=0
