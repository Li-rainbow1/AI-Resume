# 业务服务地址，不要在此文件填写真实凭据。
QA_BASE_URL=http://127.0.0.1:8999
QA_ADMIN_USERNAME=
QA_ADMIN_PASSWORD=
QA_USER_USERNAME=
QA_USER_PASSWORD=

# 只读在线契约检查也需要显式启用，避免默认执行依赖本机服务。
QA_RUN_LIVE_CONTRACT=0

# 两项必须同时为 1，RAG 主链测试才会创建并删除隔离数据。
QA_RUN_RAG_INTEGRATION=0
QA_ALLOW_RAG_WRITES=0

# 图片增强轮询参数。
QA_IMAGE_POLL_TIMEOUT_SECONDS=120
QA_IMAGE_POLL_INTERVAL_SECONDS=1

# Mock AI 默认配置。
MOCK_AI_DEFAULT_SCENARIO=normal
MOCK_AI_TIMEOUT_DELAY_SECONDS=0.2
MOCK_EMBEDDING_DIMENSIONS=1024
