# ========================================
# Docker 部署基础配置
# ========================================
# 注意：容器内的 localhost / 127.0.0.1 指向容器自身，不是宿主机。
# 如果 OpenAI-compatible 服务、Ollama、MySQL 或 PostgreSQL 运行在本机宿主机上，
# Docker 后端要使用 host.docker.internal 访问，例如 http://host.docker.internal:8080。
FRONTEND_PORT=3000
BACKEND_PORT=8999
SERVER_PORT=8999
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
APP_RAG_TOP_K=5
APP_INTERVIEW_RAG_TOP_K=4
APP_INTERVIEW_RAG_SIMILARITY_THRESHOLD=0.5
APP_INTERVIEW_CONTEXT_SOFT_CHARS=24000
APP_INTERVIEW_CONTEXT_HARD_CHARS=32000
APP_INTERVIEW_SUMMARY_CHARS=3000
APP_INTERVIEW_RAG_TIMEOUT_SECONDS=3
# 本地演示认证密钥，生产环境必须通过环境变量替换。
APP_AUTH_TOKEN_SECRET=resume-builder-local-demo-auth-secret
APP_AUTH_TOKEN_TTL_SECONDS=43200
APP_AUTH_EMAIL_CODE_SECRET=replace_with_a_separate_random_secret
APP_AUTH_EMAIL_CODE_COOLDOWN_SECONDS=60
APP_AUTH_EMAIL_CODE_EXPIRY_SECONDS=600
APP_AUTH_EMAIL_CODE_MAX_FAILED_ATTEMPTS=5
# 系统服务配置中心的 AES-GCM 根密钥，只在首次部署时手工生成并妥善备份。
APP_SYSTEM_CONFIG_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

# ========================================
# SMTP 邮箱注册与密码重置验证码（可使用 QQ、网易、Gmail、Outlook 或企业邮箱）
# ========================================
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_SECURITY_MODE=ssl
MAIL_USERNAME=
# 此处填写邮箱设置中生成的 SMTP 授权码，不是网页登录密码。
MAIL_AUTHORIZATION_CODE=
MAIL_CONNECTION_TIMEOUT_MILLIS=10000
MAIL_TIMEOUT_MILLIS=10000
MAIL_WRITE_TIMEOUT_MILLIS=10000

# ========================================
# Docker 构建基础镜像
# ========================================
# 如果 Docker Hub 访问失败，可以把下面的镜像名改成你可访问的镜像仓库完整地址。
# 例如使用公司镜像仓库或本地已 docker load 的等价镜像标签。
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:alpine
PYTHON_IMAGE=python:3.11-slim
MYSQL_IMAGE=mysql:8.4
PGVECTOR_IMAGE=pgvector/pgvector:pg17
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-11-21T17-21-54Z
FLYWAY_BASE_IMAGE=redgate/flyway:13.3.0-alpine@sha256:4c051c4081eda3a84a24e6adf4150fbda408f012c5e5167be3b0e975dc4016fc
FLYWAY_RUNTIME_IMAGE=resume-builder-flyway:13.3.0-mysql-26.7.0

# ========================================
# Docker 数据库连接
# ========================================
MYSQL_DATABASE=resume-builder
MYSQL_ROOT_PASSWORD=root
MYSQL_DATASOURCE_USERNAME=root
MYSQL_DATASOURCE_PASSWORD=root
PYTHON_MYSQL_DATASOURCE_URL=mysql+pymysql://root:root@mysql:3306/resume-builder

POSTGRES_DB=resume-builder
POSTGRES_USER=pgvector
POSTGRES_PASSWORD=pgvector
PGVECTOR_PORT=5433
PGVECTOR_DATASOURCE_USERNAME=pgvector
PGVECTOR_DATASOURCE_PASSWORD=pgvector
PYTHON_PGVECTOR_DATASOURCE_URL=postgresql+psycopg://pgvector:pgvector@pgvector:5432/resume-builder
PGVECTOR_CONNECT_TIMEOUT_SECONDS=8

# ========================================
# MinIO 知识库原始文件存储（Bucket 私有）
# ========================================
# 后端只使用专用应用账号；不要把 Root 凭证填写到 RAG_OBJECT_STORAGE_*。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_strong_minio_root_password
# 初始化容器会使用下面的专用账号创建 MinIO 策略，后端也复用同一组配置。
RAG_OBJECT_STORAGE_ENDPOINT=http://minio:9000
RAG_OBJECT_STORAGE_BUCKET=resume-builder-rag
RAG_OBJECT_STORAGE_ACCESS_KEY=rag-builder-app
RAG_OBJECT_STORAGE_SECRET_KEY=replace_with_a_strong_rag_object_storage_secret
RAG_OBJECT_STORAGE_REGION=us-east-1
RAG_IMAGE_ENRICHMENT_REDIS_URL=redis://redis:6379/0
RAG_IMAGE_ENRICHMENT_CONCURRENCY=3
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ========================================
# Flyway 版本迁移与部署备份
# ========================================
# 使用外部数据库时必须显式修改对应 URL，不能保留容器服务名 mysql 或 pgvector。
FLYWAY_MYSQL_URL=jdbc:mysql://mysql:3306/resume-builder?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
FLYWAY_MYSQL_USER=root
FLYWAY_MYSQL_PASSWORD=root
FLYWAY_POSTGRES_URL=jdbc:postgresql://pgvector:5432/resume-builder
FLYWAY_POSTGRES_USER=pgvector
FLYWAY_POSTGRES_PASSWORD=pgvector
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0
FLYWAY_CONNECT_RETRIES=60
FLYWAY_LOCK_RETRY_COUNT=50

# CI/CD 默认管理 Compose 数据库并在迁移前备份；外部数据库需改为 false 并自行提供备份。
MIGRATION_MANAGED_MYSQL=true
MIGRATION_MANAGED_POSTGRESQL=true
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_DIR=../resume-builder-database-backups
DATABASE_BACKUP_RETENTION_DAYS=14
MIGRATION_WAIT_TIMEOUT_SECONDS=180

# 如果 PostgreSQL + pgvector 已经运行在本机宿主机上，不要在 Docker URL 里写 localhost。
# 例如本机 pgvector 监听 5433 且数据库名为 resume-builder 时，可以改成：
# PGVECTOR_PORT=5433
# PGVECTOR_DATASOURCE_USERNAME=pgvector
# PGVECTOR_DATASOURCE_PASSWORD=your_pgvector_password
# PYTHON_PGVECTOR_DATASOURCE_URL=postgresql+psycopg://pgvector:your_pgvector_password@host.docker.internal:5433/resume-builder
# 启动脚本检测到外部或宿主机 pgvector URL 后，会跳过 resume-builder-pgvector 容器。

# ========================================
# OpenAI 通用与 Chat
# ========================================
# 如果你的 OpenAI-compatible Chat 服务跑在本机 localhost:8080，
# 这里应写 http://host.docker.internal:8080，而不是 http://localhost:8080。
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_CHAT_BASE_URL=https://api.openai.com
OPENAI_CHAT_API_KEY=
OPENAI_CHAT_COMPLETIONS_PATH=/v1/chat/completions
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_CHAT_TIMEOUT_SECONDS=25

# ========================================
# Embedding
# ========================================
# 如果 Ollama 跑在本机 localhost:11434，Docker 内应使用 http://host.docker.internal:11434。
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_TIMEOUT_SECONDS=10
OLLAMA_EMBEDDING_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=45

# ========================================
# Vision OCR
# ========================================
OPENAI_VISION_BASE_URL=https://api.openai.com
OPENAI_VISION_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_VISION_TIMEOUT_SECONDS=40
OPENAI_VISION_DETAIL=high

# ========================================
# Realtime 语音
# ========================================
# 可选：openai、bailian、volcengine。实时票据默认由同一 Compose 栈中的 Redis 共享。
REALTIME_PROVIDER=openai
REALTIME_PROXY_TICKET_REDIS_URL=redis://redis:6379/0
# 生产和多进程部署必须保持 false；只有单进程且明确接受内存票据风险时才设为 true。
REALTIME_PROXY_TICKET_ALLOW_MEMORY=false
OPENAI_REALTIME_BASE_URL=https://api.openai.com
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
BAILIAN_ASR_WORKSPACE_ID=
BAILIAN_ASR_API_KEY=
BAILIAN_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
BAILIAN_ASR_HOTWORDS=
BAILIAN_ASR_VOCABULARY_ID=
VOLCENGINE_ASR_APP_KEY=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_REQUEST_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# ========================================
# RAG 与扩展能力
# ========================================
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=70
RAG_MAX_FILE_SIZE_MB=10
AUTOGEN_ENABLED=false
